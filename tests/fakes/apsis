#!/usr/bin/env python3
"""Fake `apsis` for probe tests. Behaviour comes from the JSON file in FAKE_SCENARIO.

Scenario keys (all optional):
  apsis_missing     no session can be opened and listings are empty
  lmstudio_log      a file of thread ids, one per line, listed as LM Studio sessions
  sessions_dir      a directory of shared-json session documents, listed and served
Listings include every `codex exec --json` stream under --codex-exec-dir.
Every invocation is appended to FAKE_LOG as JSON.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path


def option(args: list, name: str) -> list:
    return [args[i + 1] for i, arg in enumerate(args) if arg == name]


def documents(scenario: dict) -> list:
    directory = Path(scenario.get("sessions_dir", "/nonexistent"))
    return [json.loads(p.read_text()) for p in sorted(directory.glob("*.json"))]


LISTED = ("source", "id", "project", "created_at", "model", "provider", "origin", "thread_id")


def main() -> int:
    scenario = json.loads(Path(os.environ["FAKE_SCENARIO"]).read_text())
    args = sys.argv[1:]
    with open(os.environ["FAKE_LOG"], "a") as log:
        log.write(json.dumps({"tool": "apsis", "argv": args, "cwd": os.getcwd()}) + "\n")

    if "--list" in args:
        rows = []
        if not scenario.get("apsis_missing"):
            for directory in option(args, "--codex-exec-dir"):
                for stream in sorted(Path(directory).rglob("*.jsonl")):
                    first = json.loads(stream.read_text().splitlines()[0])
                    rows.append({"source": "codex-exec", "id": f"{first['thread_id']}-x", "thread_id": first["thread_id"]})
            log_file = Path(scenario.get("lmstudio_log", "/nonexistent"))
            threads = log_file.read_text().split() if log_file.exists() else []
            for thread in threads:
                rows.append({"source": "lmstudio", "id": f"lmstudio-thread-{thread}", "thread_id": thread, "provider": "lmstudio"})
            for found in documents(scenario):
                meta = found["session"]
                row = {key: meta[key] for key in LISTED if key in meta}
                rows.append({**row, "size_bytes": len(json.dumps(found))})
        doc = {"schema_version": 1, "kind": "listing", "scope": {"all_projects": True}, "sessions": rows, "warnings": []}
        print(json.dumps(doc))
        return 0

    if scenario.get("apsis_missing"):
        print("session not found", file=sys.stderr)
        return 1
    source = option(args, "-s")[0]
    for found in documents(scenario):
        if (found["session"]["source"], found["session"]["id"]) == (source, args[-1]):
            print(json.dumps(found))
            return 0
    doc = {"schema_version": 1, "kind": "session", "session": {"source": source, "id": args[-1]}, "entries": [], "warnings": []}
    print(json.dumps(doc))
    return 0


if __name__ == "__main__":
    sys.exit(main())
