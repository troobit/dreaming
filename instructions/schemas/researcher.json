{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dreaming researcher output",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "retrieved_at": {
                  "type": "string",
                  "minLength": 1
                },
                "claim": {
                  "type": "string",
                  "minLength": 1
                },
                "passage": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "title",
                "url",
                "retrieved_at",
                "claim",
                "passage"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "finding",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "unavailable_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "findings",
    "unavailable_sources"
  ],
  "additionalProperties": false
}
